{% extends 'frontend_layout/index.html.twig' %}

{% block title %}{{ 'Patient Profile'|trans }} | {{ patient.firstName }} {{ patient.lastName }}{% endblock %}

{% block body %}
<div class="patient-view-page bg-light min-vh-100 mt-5 pt-4">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Premium Header -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                    <div class="card-body p-0">
                        <div class="p-5 text-white" style="background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                            <div class="d-flex align-items-center gap-4">
                                <div class="position-relative">
                                    <img src="{{ patient.avatar ? (patient.avatar|slice(0, 4) == 'http' or patient.avatar|slice(0, 1) == '/' ? patient.avatar : '/uploads/avatars/' ~ patient.avatar) : '/img/default-avatar.png' }}" 
                                         class="rounded-circle border border-4 border-white shadow" 
                                         style="width: 120px; height: 120px; object-fit: cover;" alt="Patient">
                                    <div class="position-absolute bottom-0 end-0 bg-success border border-3 border-white rounded-circle" style="width: 25px; height: 25px;" title="Verified Patient"></div>
                                </div>
                                <div>
                                    <div class="badge bg-white bg-opacity-20 text-white rounded-pill px-3 py-1 small mb-2">{{ 'Verified Digital ID'|trans }}</div>
                                    <h1 class="fw-bold mb-1">{{ patient.firstName }} {{ patient.lastName }}</h1>
                                    <p class="mb-0 opacity-75"><i class="bi bi-envelope me-1"></i> {{ patient.email }}</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-4 bg-white">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-4 text-center">
                                        <div class="text-muted small text-uppercase fw-bold mb-1">{{ 'Patient ID'|trans }}</div>
                                        <div class="h5 fw-bold mb-0 text-primary">#{{ patient.id|format("%05d") }}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-4 text-center">
                                        <div class="text-muted small text-uppercase fw-bold mb-1">{{ 'Phone'|trans }}</div>
                                        <div class="h5 fw-bold mb-0">{{ patient.phone|default('N/A'|trans) }}</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-4 text-center">
                                        <div class="text-muted small text-uppercase fw-bold mb-1">{{ 'Visits'|trans }}</div>
                                        <div class="h5 fw-bold mb-0">{{ consultations|length }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Consultation History -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                    <div class="card-header bg-white border-0 py-4 px-4">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>{{ 'Recent Consultations'|trans }}</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr class="small text-uppercase text-muted">
                                        <th class="ps-4 py-3 border-0">{{ 'Date'|trans }}</th>
                                        <th class="py-3 border-0">{{ 'Facility'|trans }}</th>
                                        <th class="py-3 border-0">{{ 'Doctor'|trans }}</th>
                                        <th class="pe-4 py-3 border-0 text-end">{{ 'Status'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for consultation in consultations %}
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">{{ consultation.requestedDate|date('Y-m-d') }}</div>
                                            <div class="small text-muted">{{ consultation.requestedDate|date('H:i') }}</div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold">{{ consultation.hospital.name|default('-') }}</div>
                                        </td>
                                        <td>
                                            <div class="small">{{ consultation.doctor.user.firstName|default('') }} {{ consultation.doctor.user.lastName|default('') }}</div>
                                        </td>
                                        <td class="pe-4 text-end">
                                            {% if consultation.status == 'confirmed' %}
                                                <span class="badge bg-success-subtle text-success rounded-pill px-3">{{ 'Confirmed'|trans }}</span>
                                            {% elseif consultation.status == 'cancelled' %}
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">{{ 'Cancelled'|trans }}</span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3">{{ 'Pending'|trans }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            {{ 'No consultation history found for this patient.'|trans }}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-4">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>{{ 'Back to Dashboard'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-subtle { background-color: rgba(25, 135, 84, 0.1) !important; }
    .bg-danger-subtle { background-color: rgba(220, 53, 69, 0.1) !important; }
    .bg-warning-subtle { background-color: rgba(255, 193, 7, 0.1) !important; }
    .rounded-4 { border-radius: 1rem !important; }
</style>
{% endblock %}
